# --- Server ---
PORT=4000
NODE_ENV=development

# --- Neon Postgres ---
# Connection string from the Neon console (Settings -> Connection string).
# Use the pooled (-pooler) endpoint for serverless/production use.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#
# Local dev with no Postgres? Set DB_DRIVER=pglite to run an embedded,
# file-backed Postgres (data in ./backend/.pglite). Leave DATABASE_URL empty.
# DB_DRIVER=pglite

# --- Auth ---
# REQUIRED in production. Long random string (e.g. `openssl rand -hex 32`).
# Leave empty in development to auto-generate an ephemeral secret.
JWT_SECRET=
# Access-token lifetime: s (seconds), m, h, d
JWT_EXPIRES_IN=8h
# true in production (HTTPS only). Render terminates TLS for you.
COOKIE_SECURE=false
# bcrypt cost factor
BCRYPT_ROUNDS=10

# --- CORS ---
# Comma-separated list of allowed origins, e.g. https://healthflow-ui.onrender.com
# Leave empty to disable CORS (same-origin only).
CORS_ORIGIN=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# --- Seed data ---
# Used by `npm run seed` to create (or update) the initial admin user.
ADMIN_EMAIL=admin@healthflow.local
ADMIN_NAME=HealthFlow Admin
ADMIN_PASSWORD=ChangeMe123!
